Notebook[{
  Cell[BoxData["(*\nPlotOptions.nb - reusable Mathematica plotting defaults\nRepository: https://github.com/phygibs/mathematica-styles\n\nREQUIREMENTS\nWolfram Mathematica and the MaTeX package (with its LaTeX and\nGhostscript dependencies). The font \"LM Roman 12\" is optional:\nchange PlotFontFamily below if it is not installed.\n\nUSAGE\n1. Open this .nb notebook in Mathematica and evaluate this input\n   cell (Shift+Enter).\n2. Alternatively, evaluate it from another notebook:\n\n   NotebookEvaluate[\"/path/to/PlotOptions.nb\"];\n\n   If both notebooks are in the same directory:\n\n   NotebookEvaluate[FileNameJoin[{NotebookDirectory[], \"PlotOptions.nb\"}]];\n\nThe settings apply to the current Mathematica kernel session.\nThe notebook sets frame, axes, grid-line, and label styles for\ncommon 2D plots, and defines palettes such as RGBString and\nRGBStringAlternative115. It also configures MaTeX for LaTeX labels.\n\nFor use with Overleaf, export figures from Mathematica as PDF;\nOverleaf cannot execute .nb notebooks.\n\nLICENSE - Creative Commons Attribution 4.0 International (CC BY 4.0)\nYou may copy, share, redistribute, and adapt this notebook, including\nfor commercial purposes, provided you give appropriate credit,\nlink to the license, and indicate whether changes were made.\nSuggested attribution: \"PlotOptions.nb by phygibs,\nhttps://github.com/phygibs/mathematica-styles, licensed CC BY 4.0.\"\nLicense: https://creativecommons.org/licenses/by/4.0/\nThe terms of third-party software and fonts apply separately.\n*)\n\nGeneralFontSize = 16;\nPlotFontFamily = \"LM Roman 12\";\nLabelsFontSize = GeneralFontSize;\nTicksFontSize = GeneralFontSize;\nParametersFontSize = GeneralFontSize;\nThicknessValue = 0.0015;\n\nAllPlotTypes = {Plot, ListPlot, ListLinePlot, LogPlot, LogLogPlot,\n   LogLinearPlot};\n\nSetOptions[AllPlotTypes,\n  Frame -> True,\n  FrameStyle -> Directive[Black, Thickness[ThicknessValue]],\n  GridLines -> {{0}, {0}},\n  LabelStyle -> Directive[Black, FontFamily -> PlotFontFamily,\n    FontSize -> TicksFontSize]\n];\n\nSetOptions[ContourPlot,\n  FrameStyle -> Directive[Black, Thickness[ThicknessValue]],\n  GridLines -> {{0}, {0}},\n  LabelStyle -> Directive[Black, FontFamily -> PlotFontFamily,\n    FontSize -> TicksFontSize]\n];\n\nNeeds[\"MaTeX`\"];\nSetOptions[MaTeX, FontSize -> LabelsFontSize];\nSetOptions[MaTeX, \"Preamble\" -> {\n   \"\\\\usepackage{color}\",\n   \"\\\\definecolor{MathematicaColor1}{rgb}{0.368417, 0.506779, 0.709798}\",\n   \"\\\\definecolor{MathematicaColor2}{rgb}{0.880722, 0.611041, 0.142051}\",\n   \"\\\\definecolor{MathematicaColor3}{rgb}{0.560181, 0.691569, 0.194885}\"\n}];\n\nRGBString = Table[ColorData[97, n], {n, 1, 100}];\nRGBStringLighter = Table[ColorData[96, n], {n, 1, 100}];\nRGBStringDarker = Table[ColorData[99, n], {n, 1, 100}];\nRGBStringTemperature = Table[ColorData[\"LightTemperatureMap\"][x], {x, 0, 1, 0.01}];\nRGBStringAlternative63 = Table[ColorData[63, n], {n, 1, 100}];\nRGBStringAlternative81 = Table[ColorData[81, n], {n, 1, 100}];\nRGBStringAlternative94 = Table[ColorData[94, n], {n, 1, 100}];\nRGBStringAlternative109 = Table[ColorData[109, n], {n, 1, 100}];\nRGBStringAlternative115 = Table[ColorData[115, n], {n, 1, 100}];\n\nSetOptions[AllPlotTypes, PlotStyle -> RGBStringAlternative115];\n\n(*\nEXAMPLE (after evaluating this cell)\n\nPlot[\n  Sin[x], {x, 0, 4 Pi},\n  FrameLabel -> {MaTeX[\"x\"], MaTeX[\"\\\\sin x\"]},\n  PlotLabel -> MaTeX[\"f(x)=\\\\sin x\"],\n  PlotStyle -> RGBString[[13]]\n]\n\nTo export a plot for a LaTeX/Overleaf document:\nExport[\"figure.pdf\", %];\n*)"], "Input"]
}, StyleDefinitions -> "Default.nb"]
